@using FinanceManagement.DTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginDto
@{
    ViewData["Title"] = "Вход";
}

<h1>Вход</h1>
<form asp-action="Login" method="post" class="mt-3" style="max-width: 28rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="LoginOrEmail" class="form-label"></label>
        <input asp-for="LoginOrEmail" class="form-control" autocomplete="username" />
        <span asp-validation-for="LoginOrEmail" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <div class="input-group">
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            <button type="button" class="btn btn-outline-secondary" data-password-toggle data-target="Password" aria-label="Показать пароль" aria-pressed="false">
                <svg data-eye width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-eye-off class="d-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.5 15.5 0 0 1-3 3.8M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7a10.5 10.5 0 0 0 4-.8"/></svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Войти</button>
</form>
<script src="~/js/password-visibility.js" asp-append-version="true"></script>
