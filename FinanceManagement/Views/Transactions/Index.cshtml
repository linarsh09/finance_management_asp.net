@model List<FinanceManagement.Models.OperationHistoryViewModel>

@{
    ViewData["Title"] = "Мои операции";
}

<h1>Мои операции</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Transactions"
      asp-action="Index"
      method="get"
      class="row g-3 mb-3">

    <div class="col-auto">
        <label for="accountId" class="form-label">Счёт</label>
        <select id="accountId"
                name="accountId"
                asp-items="ViewBag.Accounts"
                class="form-select">
            <option value="">Все счета</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="dateFrom" class="form-label">С даты</label>
        <input type="date"
               id="dateFrom"
               name="dateFrom"
               value="@ViewBag.DateFrom"
               class="form-control" />
    </div>

    <div class="col-auto">
        <label for="dateTo" class="form-label">По дату</label>
        <input type="date"
               id="dateTo"
               name="dateTo"
               value="@ViewBag.DateTo"
               class="form-control" />
    </div>

    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">
            Показать
        </button>

        <a asp-controller="Transactions"
           asp-action="Index"
           class="btn btn-secondary">
            Сбросить
        </a>
    </div>
</form>

@if (ViewBag.CurrencyTotals is
    List<FinanceManagement.Models.CurrencyTotalsViewModel> totals
    && totals.Count > 0)
{
    <h2 class="h4">Итоги по фильтру</h2>

    <table class="table table-bordered mb-4">
        <thead>
            <tr>
                <th>Валюта</th>
                <th>Доходы</th>
                <th>Расходы</th>
                <th>Разница</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var total in totals)
            {
                <tr>
                    <td>@total.CurrencyCode</td>
                    <td>@total.Income.ToString("N2")</td>
                    <td>@total.Expense.ToString("N2")</td>
                    <td>@total.Difference.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">
        Переводы между счетами не включены.
        Разница — доходы минус расходы за выбранный период.
    </p>
}

<a asp-controller="Transactions"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Добавить операцию
</a>

<a asp-controller="Transfers"
   asp-action="Create"
   class="btn btn-outline-primary mb-3">
    Перевод между счетами
</a>

@if (Model.Count == 0)
{
    <p>За выбранный период операций нет.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Счёт / направление</th>
                <th>Категория</th>
                <th>Тип</th>
                <th>Сумма</th>
                <th>Примечание</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var operation in Model)
            {
                <tr>
                    <td>@operation.Date.ToString("dd.MM.yyyy")</td>
                    <td>@operation.AccountLabel</td>
                    <td>@(operation.CategoryName ?? "—")</td>
                    <td>@operation.TypeLabel</td>
                    <td>
                        @operation.Amount.ToString("N2")
                        @operation.CurrencyCode
                    </td>
                    <td>@operation.Note</td>
                    <td>
                        @if (!operation.IsTransfer)
                        {
                            <a asp-controller="Transactions"
                               asp-action="Edit"
                               asp-route-id="@operation.Id"
                               class="btn btn-sm btn-outline-primary mb-1">
                                Редактировать
                            </a>

                            <form asp-controller="Transactions"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Удалить эту операцию?');">

                                <input type="hidden"
                                       name="id"
                                       value="@operation.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Удалить
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Transfers"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Удалить перевод? Балансы обоих счетов будут пересчитаны.');">

                                <input type="hidden"
                                       name="id"
                                       value="@operation.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Удалить перевод
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
