@model List<FinanceManagement.Models.Category>

@{
    ViewData["Title"] = "Мои категории";
}

<h1>Мои категории</h1>

<a asp-controller="Categories"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Добавить категорию
</a>

@if (Model.Count == 0)
{
    <p>Пока нет категорий. Создайте первую.</p>
}
else
{
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Тип</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        @(category.Type == FinanceManagement.Models.TransactionType.Income
                            ? "Доход"
                            : "Расход")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}