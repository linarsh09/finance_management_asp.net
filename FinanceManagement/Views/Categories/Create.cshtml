@model FinanceManagement.Models.CreateCategoryViewModel

@{
    ViewData["Title"] = "Создать категорию";
}

<h1>Создать категорию</h1>

<form asp-controller="Categories" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select">
            <option value="1">Доход</option>
            <option value="2">Расход</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>

    <a asp-controller="Categories" asp-action="Index"
       class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}