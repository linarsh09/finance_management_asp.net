@model List<FinanceManagement.Models.Account>

@{
    ViewData["Title"] = "Мои счета";
}

<h1>Мои счета</h1>

<p>Количество моих счетов: @Model.Count</p>

<a asp-controller="Accounts"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Добавить счёт
</a>

@if (Model.Count == 0)
{
    <p>У вас пока нет счетов. Создайте первый.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Валюта</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in Model)
            {
                <tr>
                    <td>@account.Name</td>
                    <td>@account.CurrencyCode</td>
                </tr>
            }
        </tbody>
    </table>
}