@model FinanceManagement.Models.CreateTransferViewModel

@{
    ViewData["Title"] = "Перевод между счетами";
}

<h1>Перевод между счетами</h1>

<form asp-controller="Transfers" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FromAccountId" class="form-label"></label>
        <select asp-for="FromAccountId"
                asp-items="ViewBag.FromAccounts"
                class="form-select">
            <option value="">Выберите счёт списания</option>
        </select>
        <span asp-validation-for="FromAccountId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ToAccountId" class="form-label"></label>
        <select asp-for="ToAccountId"
                asp-items="ViewBag.ToAccounts"
                class="form-select">
            <option value="">Выберите счёт зачисления</option>
        </select>
        <span asp-validation-for="ToAccountId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount"
               type="number"
               min="0.01"
               step="0.01"
               class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
        <div class="form-text">
            Перевод доступен между счетами в одной валюте.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Note" class="form-label"></label>
        <textarea asp-for="Note" class="form-control"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Перевести
    </button>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Отмена
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}