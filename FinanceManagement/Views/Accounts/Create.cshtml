@model FinanceManagement.Models.CreateAccountViewModel

@{
    ViewData["Title"] = "Создать счёт";
}

<h1>Создать счёт</h1>

<form asp-controller="Accounts" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrencyCode" class="form-label"></label>
        <select asp-for="CurrencyCode" class="form-select">
            <option value="KZT">KZT — тенге</option>
            <option value="USD">USD — доллар США</option>
            <option value="EUR">EUR — евро</option>
        </select>
        <span asp-validation-for="CurrencyCode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>
    <a asp-controller="Home" asp-action="Index"
       class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}